# Databricks
DATABRICKS_HOST=https://<your-databricks-instance>
DATABRICKS_TOKEN=<your-databricks-token>

# SQL Warehouse (for fetching sample data)
WAREHOUSE_HTTP_PATH=/sql/1.0/warehouses/<your-warehouse-id>

# LLM Provider: "databricks" or "groq"
LLM_PROVIDER=databricks

# Databricks Model Serving (when LLM_PROVIDER=databricks)
# The serving endpoint name as shown in Databricks UI (e.g. my-llama-endpoint)
MODEL_SERVING_ENDPOINT_NAME=<your-serving-endpoint-name>
MODEL_SERVING_TOKEN=<your-databricks-token>

# Groq (when LLM_PROVIDER=groq)
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=llama3-8b-8192

# GitHub
GITHUB_TOKEN=<your-github-pat>
REPO_NAME=<github-username/repo-name>
